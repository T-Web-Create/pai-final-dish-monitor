<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="empty">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="camera_stand">
      <static>true</static>
      <pose>0.525 0 0 0 0 0</pose>
      <link name="link">
        <visual name="base">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 0.004 0 0 0</pose>
          <geometry><cylinder><radius>0.040</radius><length>0.008</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse><specular>0.30 0.30 0.30 1</specular></material>
        </visual>
        <visual name="post">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 0.150 0 0 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.290</length></cylinder></geometry>
          <material><ambient>0.70 0.70 0.72 1</ambient><diffuse>0.70 0.70 0.72 1</diffuse><specular>0.80 0.80 0.80 1</specular></material>
        </visual>
        <visual name="bracket">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 0.300 0 0 0</pose>
          <geometry><box><size>0.024 0.030 0.016</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse><specular>0.30 0.30 0.30 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="dish_camera">
      <static>true</static>
      <pose>0.50 0 0.30 0 0.95 3.14159</pose>
      <link name="link">
        <visual name="cam_body">
          <cast_shadows>false</cast_shadows>
          <pose>-0.020 0 0 0 0 0</pose>
          <geometry><box><size>0.040 0.029 0.029</size></box></geometry>
          <material><ambient>0.20 0.20 0.22 1</ambient><diffuse>0.20 0.20 0.22 1</diffuse><specular>0.30 0.30 0.30 1</specular></material>
        </visual>
        <visual name="cam_lens">
          <cast_shadows>false</cast_shadows>
          <pose>0.0165 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.033</length></cylinder></geometry>
          <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse><specular>0.50 0.50 0.50 1</specular></material>
        </visual>
        <visual name="cam_lens_ring">
          <cast_shadows>false</cast_shadows>
          <pose>0.033 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.0155</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse><specular>0.80 0.80 0.80 1</specular></material>
        </visual>
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>0.7</horizontal_fov>
            <image>
              <width>1280</width>
              <height>960</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.05</near><far>2.0</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>dish_camera/image</topic>
        </sensor>
      </link>
    </model>
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>0.272 -0.450 0.480 0 0.540 1.570</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"><gz-gui><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property></gz-gui></plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control"><gz-gui><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property></gz-gui></plugin>
      <plugin filename="CameraTracking" name="Camera Tracking"><gz-gui><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property></gz-gui></plugin>
      <plugin filename="MarkerManager" name="Marker manager"><gz-gui><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property></gz-gui></plugin>
    </gui>
  </world>
</sdf>

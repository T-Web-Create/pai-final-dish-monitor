<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:arg name="name" default="ur"/>

  <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.urdf.xacro"/>

  <link name="suction_link">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="8.75e-6" iyy="8.75e-6" izz="1.0e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.017" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.034"/></geometry>
      <material name="suction_gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.037" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.006"/></geometry>
      <material name="suction_cup"><color rgba="0.9 0.4 0.1 1"/></material>
    </visual>
  </link>

  <joint name="suction_joint" type="fixed">
    <parent link="tool0"/>
    <child link="suction_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="suction_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>suction_link</parent_link>
      <child_model>dish_lid</child_model>
      <child_link>link</child_link>
      <attach_topic>/suction/attach</attach_topic>
      <detach_topic>/suction/detach</detach_topic>
      <output_topic>/suction/state</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>
  </gazebo>
</robot>
